{"$schema": "http://json-schema.org/draft-07/schema#", "title": "AutoFinPDF extraction output", "type": "object", "required": ["meta", "statements", "key_metrics", "deliveries", "events", "uncertain"], "additionalProperties": false, "properties": {"meta": {"type": "object", "required": ["company", "market", "doc_type", "fiscal_period", "currency", "accounting_standard"], "properties": {"company": {"type": "string"}, "market": {"enum": ["US", "HK", "A"]}, "doc_type": {"type": "string"}, "fiscal_period": {"type": "string"}, "currency": {"enum": ["CNY", "USD"]}, "accounting_standard": {"enum": ["US_GAAP", "CAS", "IFRS"]}}}, "statements": {"type": "array", "items": {"$ref": "#/definitions/line"}}, "key_metrics": {"type": "array", "items": {"$ref": "#/definitions/line"}}, "deliveries": {"type": "array", "items": {"type": "object", "required": ["month", "model", "count", "page"], "properties": {"month": {"type": "string", "description": "YYYY-MM"}, "model": {"type": "string"}, "count": {"type": "number"}, "page": {"type": "integer"}}}}, "events": {"type": "array", "items": {"type": "object", "required": ["date", "type", "summary", "page"], "properties": {"date": {"type": "string"}, "type": {"type": "string"}, "summary": {"type": "string"}, "page": {"type": "integer"}}}}, "uncertain": {"type": "array", "items": {"type": "object", "properties": {"field": {"type": "string"}, "reason": {"type": "string"}}}}}, "definitions": {"line": {"type": "object", "required": ["statement", "item", "period", "value", "unit", "currency", "page"], "additionalProperties": false, "properties": {"statement": {"enum": ["income_statement", "balance_sheet", "cash_flow", "metric"]}, "item": {"type": "string", "description": "controlled vocabulary code, see standard/prompts.md"}, "period": {"type": "string", "description": "FY2025 / Q3 2025 / 2025-10"}, "value": {"type": "number"}, "unit": {"enum": ["yuan", "thousand", "million", "billion", "wan", "yi", "percent", "count", "yuan_per_share"]}, "curre